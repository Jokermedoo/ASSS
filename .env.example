# KYCtrust Platform Environment Configuration
# Copy this file to .env and update the values

# ==============================================
# APPLICATION SETTINGS
# ==============================================
VITE_APP_NAME=KYCtrust
VITE_APP_VERSION=2.0.0
VITE_APP_ENV=development
VITE_API_URL=http://localhost:5173/api
VITE_APP_URL=http://localhost:5173

# ==============================================
# DATABASE CONFIGURATION (Supabase)
# ==============================================
# Get these from your Supabase project settings
DATABASE_URL=postgresql://user:password@host:port/database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ==============================================
# AUTHENTICATION & SECURITY (Admin Only - No User Registration)
# ==============================================
# Simple admin authentication - no user registration system
ADMIN_PASSWORD=your_admin_password_here
ENCRYPTION_KEY=your_32_character_encryption_key_here

# ==============================================
# EMAIL CONFIGURATION
# ==============================================
# SMTP settings for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password

# Email templates and settings
FROM_EMAIL=noreply@kyctrust.com
FROM_NAME=KYCtrust Platform
SUPPORT_EMAIL=support@kyctrust.com

# ==============================================
# WHATSAPP INTEGRATION
# ==============================================
# WhatsApp Business API settings
WHATSAPP_API_TOKEN=your_whatsapp_api_token
WHATSAPP_PHONE_NUMBER=+966501234567
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# ==============================================
# FILE UPLOAD & STORAGE (Cloudinary)
# ==============================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=kyctrust

# ==============================================
# PAYMENT PROCESSING (Optional)
# ==============================================
# Stripe configuration
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayPal configuration (if needed)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# ==============================================
# ANALYTICS & MONITORING
# ==============================================
# Google Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX

# Error monitoring (Sentry)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENV=development

# Performance monitoring
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key

# ==============================================
# EXTERNAL APIs
# ==============================================
# Currency exchange rates
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key

# Cryptocurrency prices
CRYPTO_API_KEY=your_crypto_api_key
COINMARKET_API_KEY=your_coinmarketcap_api_key

# SMS notifications (optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ==============================================
# SOCIAL MEDIA & INTEGRATIONS
# ==============================================
# Social media links
FACEBOOK_PAGE_URL=https://facebook.com/kyctrust
TWITTER_HANDLE=@kyctrust
INSTAGRAM_URL=https://instagram.com/kyctrust
LINKEDIN_URL=https://linkedin.com/company/kyctrust

# Social login (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# ==============================================
# BACKUP & MAINTENANCE
# ==============================================
# Backup settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/backups

# Maintenance mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=We're currently performing maintenance. Please check back soon.

# ==============================================
# RATE LIMITING & SECURITY
# ==============================================
# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security headers
ENABLE_SECURITY_HEADERS=true
CORS_ORIGIN=http://localhost:5173

# ==============================================
# DEVELOPMENT & DEBUGGING
# ==============================================
# Development settings
NODE_ENV=development
DEBUG=false
LOG_LEVEL=info

# Vite specific
VITE_DEBUG=false
VITE_MOCK_API=false

# ==============================================
# FEATURE FLAGS
# ==============================================
# Enable/disable features
FEATURE_PAGE_BUILDER=true
FEATURE_ANALYTICS=true
FEATURE_BACKUP=true
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_WHATSAPP_INTEGRATION=true
FEATURE_PAYMENT_PROCESSING=false
FEATURE_MULTI_LANGUAGE=true

# ==============================================
# API KEYS & TOKENS
# ==============================================
# Add any additional API keys here
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# ==============================================
# CUSTOM CONFIGURATION
# ==============================================
# Custom settings for your deployment
CUSTOM_DOMAIN=kyctrust.com
BRAND_COLOR=#3B82F6
SUPPORT_PHONE=+966501234567
COMPANY_ADDRESS=Riyadh, Saudi Arabia

# Database connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000

# Session settings
SESSION_SECRET=your_session_secret_here
SESSION_TIMEOUT=3600000

# File upload limits
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# Internationalization
DEFAULT_LANGUAGE=ar
SUPPORTED_LANGUAGES=ar,en
DEFAULT_TIMEZONE=Asia/Riyadh
DEFAULT_CURRENCY=SAR

# ==============================================
# PRODUCTION OVERRIDES
# ==============================================
# These will be overridden in production
# VITE_API_URL=https://api.kyctrust.com
# NEXTAUTH_URL=https://kyctrust.com
# NODE_ENV=production
# DEBUG=false
