# KYCtrust Platform Environment Configuration
# Production-ready configuration

# ==============================================
# APPLICATION SETTINGS
# ==============================================
VITE_APP_NAME=KYCtrust
VITE_APP_VERSION=2.0.0
VITE_APP_ENV=production
VITE_API_URL=http://localhost:5173/api
VITE_APP_URL=http://localhost:5173

# ==============================================
# DATABASE CONFIGURATION 
# ==============================================
DATABASE_URL=sqlite:./kyctrust.db
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ==============================================
# AUTHENTICATION & SECURITY
# ==============================================
ADMIN_PASSWORD=KYCtrust@2024!
ENCRYPTION_KEY=KYCtrust2024SecureKey123456789ABC
JWT_SECRET=KYCtrust_JWT_Secret_Key_2024_Secure

# ==============================================
# WHATSAPP INTEGRATION
# ==============================================
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER=+201062453344
WHATSAPP_WEBHOOK_VERIFY_TOKEN=kyctrust_webhook_2024

# ==============================================
# EMAIL CONFIGURATION
# ==============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

FROM_EMAIL=noreply@kyctrust.com
FROM_NAME=KYCtrust Platform
SUPPORT_EMAIL=support@kyctrust.com

# ==============================================
# ANALYTICS & MONITORING
# ==============================================
GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=
SENTRY_DSN=
SENTRY_ENV=production

# ==============================================
# PERFORMANCE SETTINGS
# ==============================================
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_PERFORMANCE_TRACKING=true
VITE_ENABLE_ERROR_REPORTING=true

# ==============================================
# RATE LIMITING & SECURITY
# ==============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
ENABLE_SECURITY_HEADERS=true
CORS_ORIGIN=http://localhost:5173

# ==============================================
# FEATURE FLAGS
# ==============================================
FEATURE_PAGE_BUILDER=true
FEATURE_ANALYTICS=true
FEATURE_BACKUP=true
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_WHATSAPP_INTEGRATION=true
FEATURE_PAYMENT_PROCESSING=false
FEATURE_USER_REGISTRATION=false
FEATURE_MULTI_LANGUAGE=true
FEATURE_MANUAL_ORDERS=true

# ==============================================
# DEVELOPMENT & DEBUGGING
# ==============================================
NODE_ENV=production
DEBUG=false
LOG_LEVEL=info
VITE_DEBUG=false
VITE_MOCK_API=false

# ==============================================
# LOCALIZATION
# ==============================================
DEFAULT_LANGUAGE=ar
SUPPORTED_LANGUAGES=ar,en
DEFAULT_TIMEZONE=Asia/Riyadh
DEFAULT_CURRENCY=SAR

# ==============================================
# PERFORMANCE & OPTIMIZATION
# ==============================================
VITE_BUILD_OPTIMIZE=true
VITE_ENABLE_PWA=true
VITE_ENABLE_COMPRESSION=true
VITE_CHUNK_SIZE_WARNING_LIMIT=1000

# ==============================================
# SOCIAL MEDIA
# ==============================================
FACEBOOK_PAGE_URL=https://facebook.com/kyctrust
TWITTER_HANDLE=@kyctrust
INSTAGRAM_URL=https://instagram.com/kyctrust
LINKEDIN_URL=https://linkedin.com/company/kyctrust

# ==============================================
# BACKUP & MAINTENANCE
# ==============================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
MAINTENANCE_MODE=false

# ==============================================
# CUSTOM BRANDING
# ==============================================
CUSTOM_DOMAIN=kyctrust.com
BRAND_COLOR=#3B82F6
SUPPORT_PHONE=+201062453344
COMPANY_ADDRESS=Cairo, Egypt

# ==============================================
# FILE UPLOAD SETTINGS
# ==============================================
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# ==============================================
# SESSION SETTINGS
# ==============================================
SESSION_SECRET=KYCtrust_Session_Secret_2024_Secure_Key
SESSION_TIMEOUT=3600000

# ==============================================
# DATABASE POOL SETTINGS
# ==============================================
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
